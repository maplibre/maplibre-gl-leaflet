{
  "name": "@maplibre/maplibre-gl-leaflet",
  "version": "0.1.4",
  "description": "Supports adding Maplibre GL Web to a Leaflet Map as a layer",
  "main": "leaflet-maplibre-gl.js",
  "module": "dist/leaflet-maplibre-gl.mjs",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/leaflet-maplibre-gl.d.mts",
        "default": "./dist/leaflet-maplibre-gl.mjs"
      },
      "require": {
        "types": "./leaflet-maplibre-gl.d.ts",
        "default": "./leaflet-maplibre-gl.js"
      },
      "default": "./dist/leaflet-maplibre-gl.mjs"
    },
    "./leaflet-maplibre-gl": {
      "types": "./leaflet-maplibre-gl.d.ts",
      "default": "./leaflet-maplibre-gl.js"
    },
    "./leaflet-maplibre-gl.js": {
      "types": "./leaflet-maplibre-gl.d.ts",
      "default": "./leaflet-maplibre-gl.js"
    },
    "./*": "./*"
  },
  "files": [
    "API.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "debug",
    "dist",
    "examples",
    "leaflet-maplibre-gl.js",
    "leaflet-maplibre-gl.d.ts"
  ],
  "directories": {
    "example": "examples"
  },
  "scripts": {
    "build": "rolldown --config rolldown.config.mjs",
    "prepack": "npm run build",
    "typecheck": "tsc --project test/tsconfig.json",
    "test": "npm run build && jshint dist/leaflet-maplibre-gl.js && npm run typecheck && node --test test/compatibility.test.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/maplibre/maplibre-gl-leaflet.git"
  },
  "keywords": [
    "maplibre",
    "gl",
    "leaflet",
    "leafletjs",
    "maps"
  ],
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/maplibre/maplibre-gl-leaflet/issues"
  },
  "homepage": "https://github.com/maplibre/maplibre-gl-leaflet",
  "devDependencies": {
    "jshint": "^2.10.1",
    "rolldown": "^1.2.4",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@types/leaflet": "^1.9.0",
    "leaflet": "^1.9.3",
    "maplibre-gl": "^2.4.0 || ^3.3.1 || ^4.3.2 || ^5.0.0 || ^6.0.0"
  },
  "types": "leaflet-maplibre-gl.d.ts"
}
